# Local development — app runs on the host; Postgres via Compose uses localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/support_tickets_test?schema=public"
PORT=3001
NODE_ENV=development

# Docker Compose — set automatically on the backend service (do not use in backend/.env for local npm run dev):
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/support_tickets?schema=public"
# NODE_ENV=production
# PORT=3001
#
# Frontend (Docker): leave VITE_API_BASE_URL empty so the browser calls same-origin `/api`
# (nginx proxies to the backend). For a direct API URL instead, build with e.g.:
#   VITE_API_BASE_URL=http://localhost:3001
